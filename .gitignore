# Node.js 의존성
/node_modules/

# 빌드 결과물
/build/
# Create React App의 경우 빌드 파일들이 /build/ 폴더에 저장됩니다.

# .env 파일 (환경 변수 파일)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 임시 파일들
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS 관련 파일들 (예: macOS에서 생성되는 파일들)
.DS_Store
Thumbs.db

# IDE 관련 파일들 (예: Visual Studio Code의 설정 파일)
.vscode/
.idea/

# 기타
*.swp   # Vim의 스왑 파일

